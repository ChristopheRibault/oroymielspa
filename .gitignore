# Root gitignore for oroymiel

# dependencies
node_modules/
app-front/node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage/
app-front/coverage/

# next.js
app-front/.next/
app-front/out/

# production
build/
app-front/build/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*
app-front/.env*

# vercel
.vercel
app-front/.vercel

# typescript
*.tsbuildinfo
app-front/next-env.d.ts

# sanity studio
sanity/node_modules/
sanity/dist/
sanity/.sanity/
sanity/.turbo/

images
